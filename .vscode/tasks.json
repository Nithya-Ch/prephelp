{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start ML Service",
      "type": "shell",
      "command": "python -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
      "options": {
        "cwd": "${workspaceFolder}/ml-service"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "prephelp",
        "panel": "new",
        "reveal": "always"
      }
    },
    {
      "label": "Start Server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "prephelp",
        "panel": "new",
        "reveal": "always"
      }
    },
    {
      "label": "Start Worker",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/worker"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "prephelp",
        "panel": "new",
        "reveal": "always"
      }
    },
    {
      "label": "Start Client",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "prephelp",
        "panel": "new",
        "reveal": "always"
      }
    },
    {
      "label": "Seed Database",
      "type": "shell",
      "command": "npm run seed",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Start All Services (PrepHelp)",
      "dependsOn": [
        "Start ML Service",
        "Start Server",
        "Start Worker",
        "Start Client"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
